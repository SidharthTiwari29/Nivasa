DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/niwasthan
# Neon (and similar poolers like Supabase/PgBouncer) require a SEPARATE
# direct connection for schema migrations - the pooled connection above
# (DATABASE_URL) can fail on CREATE TABLE and other schema-changing
# operations. For Neon specifically: use the connection string WITHOUT
# "-pooler" in the hostname. If your database has no pooler at all
# (local Postgres), this can be identical to DATABASE_URL or omitted -
# prisma.config.ts falls back to DATABASE_URL automatically.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/niwasthan
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SERVER=
EMAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REDIS_URL=redis://localhost:6379
JOB_CONCURRENCY=4
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
AI_PROVIDER=
RENDERING_PROVIDER=
PAYMENT_PROVIDER=razorpay
# Anthropic API key for the customer-facing FAQ/help assistant
# (src/server/assistant). Get one at https://console.anthropic.com -
# self-serve, no partnership required. Leave empty to have the assistant
# endpoint fail closed with ASSISTANT_NOT_CONFIGURED rather than silently
# returning a canned or fabricated answer.
ANTHROPIC_API_KEY=
# Provider credentials are intentionally empty in source control.
