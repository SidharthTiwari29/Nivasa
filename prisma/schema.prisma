generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { USER DESIGNER ADMIN SUPER_ADMIN }
enum LifecycleStatus { DRAFT ACTIVE ARCHIVED DELETED }
enum SourceKind { AI_ESTIMATED USER_CONFIRMED SYSTEM_IMPORTED }
enum JobStatus { QUEUED RUNNING SUCCEEDED FAILED CANCELLED }
enum PaymentStatus { CREATED PENDING AUTHORIZED CAPTURED FAILED REFUNDED }
enum PurchaseStatus { CREATED PAYMENT_PENDING ACTIVE CANCELLED EXPIRED REFUNDED }
enum AssetKind { IMAGE PANORAMA SCENE_3D WALKTHROUGH VIDEO JSON PDF }

model User { id String @id @default(cuid()) email String @unique name String? image String? emailVerified DateTime? role Role @default(USER) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt properties Property[] projects DesignProject[] purchases Purchase[] usageRecords UsageRecord[] entitlementGrants EntitlementGrant[] analyticsEvents AnalyticsEvent[] accounts Account[] sessions Session[] }
model Account { id String @id @default(cuid()) userId String type String provider String providerAccountId String refresh_token String? access_token String? expires_at Int? token_type String? scope String? id_token String? session_state String? user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@unique([provider,providerAccountId]) @@index([userId]) }
model Session { id String @id @default(cuid()) sessionToken String @unique userId String expires DateTime user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@index([userId]) }
model VerificationToken { identifier String token String @unique expires DateTime @@unique([identifier,token]) }
model AdminUser { id String @id @default(cuid()) userId String @unique role Role @default(ADMIN) createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
model Property { id String @id @default(cuid()) ownerId String name String address Json? status LifecycleStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt owner User @relation(fields:[ownerId], references:[id]) documents PropertyDocument[] floorPlans FloorPlan[] projects DesignProject[] @@index([ownerId]) }
model PropertyDocument { id String @id @default(cuid()) propertyId String storageKey String contentType String purpose String status LifecycleStatus @default(ACTIVE) createdAt DateTime @default(now()) property Property @relation(fields:[propertyId], references:[id]) @@index([propertyId]) }
model FloorPlan { id String @id @default(cuid()) propertyId String uploadDocumentId String? status String @default("UPLOADED") sourceOfTruth Json? structuredJson Json? confidence Decimal? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt property Property @relation(fields:[propertyId], references:[id]) rooms Room[] walls Wall[] doors Door[] windows Window[] @@index([propertyId,status]) }
model Room { id String @id @default(cuid()) floorPlanId String name String? roomType String? geometry Json measurements Json? measurementSource SourceKind @default(AI_ESTIMATED) confidence Decimal? floorPlan FloorPlan @relation(fields:[floorPlanId], references:[id]) @@index([floorPlanId]) }
model Wall { id String @id @default(cuid()) floorPlanId String geometry Json measurements Json? measurementSource SourceKind @default(AI_ESTIMATED) confidence Decimal? floorPlan FloorPlan @relation(fields:[floorPlanId], references:[id]) }
model Door { id String @id @default(cuid()) floorPlanId String geometry Json measurements Json? measurementSource SourceKind @default(AI_ESTIMATED) confidence Decimal? floorPlan FloorPlan @relation(fields:[floorPlanId], references:[id]) }
model Window { id String @id @default(cuid()) floorPlanId String geometry Json measurements Json? measurementSource SourceKind @default(AI_ESTIMATED) confidence Decimal? floorPlan FloorPlan @relation(fields:[floorPlanId], references:[id]) }
model DesignProject { id String @id @default(cuid()) ownerId String propertyId String name String status LifecycleStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt owner User @relation(fields:[ownerId], references:[id]) property Property @relation(fields:[propertyId], references:[id]) concepts DesignConcept[] versions DesignVersion[] budgets Budget[] @@index([ownerId,propertyId]) }
model DesignConcept { id String @id @default(cuid()) projectId String prompt String? specification Json status LifecycleStatus @default(DRAFT) createdAt DateTime @default(now()) project DesignProject @relation(fields:[projectId], references:[id]) versions DesignVersion[] }
model DesignVersion { id String @id @default(cuid()) projectId String conceptId String? versionNumber Int inputsSnapshot Json specification Json selectedItems Json? costSnapshot Json? providerMetadata Json? createdAt DateTime @default(now()) project DesignProject @relation(fields:[projectId], references:[id]) concept DesignConcept? @relation(fields:[conceptId], references:[id]) revisions DesignRevision[] renders Render[] estimates CostEstimate[] boqs BOQ[] @@unique([projectId,versionNumber]) }
model DesignRevision { id String @id @default(cuid()) designVersionId String revisionNumber Int inputsSnapshot Json specification Json selectedItems Json? costSnapshot Json? providerMetadata Json? createdAt DateTime @default(now()) version DesignVersion @relation(fields:[designVersionId], references:[id]) renders Render[] @@unique([designVersionId,revisionNumber]) }
model Render { id String @id @default(cuid()) designVersionId String? designRevisionId String? kind AssetKind storageKey String? provider String? providerJobId String? metadata Json? status JobStatus @default(QUEUED) createdAt DateTime @default(now()) version DesignVersion? @relation(fields:[designVersionId], references:[id]) revision DesignRevision? @relation(fields:[designRevisionId], references:[id]) @@index([provider,providerJobId]) }
model ProductCategory { id String @id @default(cuid()) name String parentId String? products Product[] parent ProductCategory? @relation("CategoryTree", fields:[parentId], references:[id]) children ProductCategory[] @relation("CategoryTree") }
model Product { id String @id @default(cuid()) categoryId String sku String @unique name String status LifecycleStatus @default(ACTIVE) attributes Json? category ProductCategory @relation(fields:[categoryId], references:[id]) prices ProductPrice[] availability ProductAvailability[] alternatives ProductAlternative[] @relation("ProductAlternatives") alternativeFor ProductAlternative[] @relation("AlternativeProducts") }
model Material { id String @id @default(cuid()) code String @unique name String attributes Json? status LifecycleStatus @default(ACTIVE) }
model ProductPrice { id String @id @default(cuid()) productId String currency String amountMinor Int effectiveFrom DateTime effectiveTo DateTime? snapshotVersion String product Product @relation(fields:[productId], references:[id]) @@index([productId,effectiveFrom]) }
model ProductAvailability { id String @id @default(cuid()) productId String region String status String quantity Int? checkedAt DateTime @default(now()) product Product @relation(fields:[productId], references:[id]) @@unique([productId,region]) }
model ProductAlternative { id String @id @default(cuid()) productId String alternativeProductId String reason String? product Product @relation("ProductAlternatives", fields:[productId], references:[id]) alternative Product @relation("AlternativeProducts", fields:[alternativeProductId], references:[id]) @@unique([productId,alternativeProductId]) }
model LabourRate { id String @id @default(cuid()) region String trade String currency String amountMinor Int unit String effectiveFrom DateTime effectiveTo DateTime? @@index([region,trade]) }
model InstallationCost { id String @id @default(cuid()) productCategoryId String? region String currency String amountMinor Int unit String effectiveFrom DateTime effectiveTo DateTime? }
model DeliveryCost { id String @id @default(cuid()) region String currency String amountMinor Int rules Json effectiveFrom DateTime effectiveTo DateTime? }
model TaxConfiguration { id String @id @default(cuid()) region String taxCode String rateBps Int effectiveFrom DateTime effectiveTo DateTime? @@index([region,taxCode]) }
model CostEstimate { id String @id @default(cuid()) designVersionId String currency String subtotalMinor Int taxMinor Int totalMinor Int assumptionsSnapshot Json createdAt DateTime @default(now()) version DesignVersion @relation(fields:[designVersionId], references:[id]) }
model Budget { id String @id @default(cuid()) projectId String name String currency String targetMinor Int createdAt DateTime @default(now()) project DesignProject @relation(fields:[projectId], references:[id]) scenarios BudgetScenario[] }
model BudgetScenario { id String @id @default(cuid()) budgetId String name String assumptions Json totals Json createdAt DateTime @default(now()) budget Budget @relation(fields:[budgetId], references:[id]) }
model BOQ { id String @id @default(cuid()) designVersionId String currentVersionId String? createdAt DateTime @default(now()) designVersion DesignVersion @relation(fields:[designVersionId], references:[id]) versions BOQVersion[] }
model BOQVersion { id String @id @default(cuid()) boqId String versionNumber Int pricingSnapshot Json taxSnapshot Json labourSnapshot Json totals Json createdAt DateTime @default(now()) boq BOQ @relation(fields:[boqId], references:[id]) items BOQItem[] @@unique([boqId,versionNumber]) }
model BOQItem { id String @id @default(cuid()) boqVersionId String itemType String referenceId String? description String quantity Decimal unit String unitAmountMinor Int totalAmountMinor Int metadata Json? boqVersion BOQVersion @relation(fields:[boqVersionId], references:[id]) }
model Package { id String @id @default(cuid()) code String @unique name String currency String priceMinor Int status LifecycleStatus @default(ACTIVE) features PackageFeature[] entitlements PackageEntitlement[] purchases Purchase[] }
model PackageFeature { id String @id @default(cuid()) packageId String code String name String metadata Json? package Package @relation(fields:[packageId], references:[id]) @@unique([packageId,code]) }
model PackageEntitlement { id String @id @default(cuid()) packageId String code String limit Int period String metadata Json? package Package @relation(fields:[packageId], references:[id]) grants EntitlementGrant[] @@unique([packageId,code]) }
model Purchase { id String @id @default(cuid()) userId String packageId String status PurchaseStatus @default(CREATED) startsAt DateTime? endsAt DateTime? idempotencyKey String @unique createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) package Package @relation(fields:[packageId], references:[id]) payments Payment[] invoices Invoice[] entitlementGrants EntitlementGrant[] }
model Payment { id String @id @default(cuid()) purchaseId String provider String providerOrderId String? providerPaymentId String? status PaymentStatus @default(CREATED) amountMinor Int currency String idempotencyKey String @unique createdAt DateTime @default(now()) purchase Purchase @relation(fields:[purchaseId], references:[id]) events PaymentEvent[] refunds Refund[] @@index([provider,providerOrderId]) }
model PaymentEvent { id String @id @default(cuid()) paymentId String? provider String eventId String eventType String payload Json receivedAt DateTime @default(now()) processedAt DateTime? payment Payment? @relation(fields:[paymentId], references:[id]) @@unique([provider,eventId]) }
model EntitlementGrant { id String @id @default(cuid()) userId String purchaseId String packageEntitlementId String entitlementCode String limit Int remaining Int reserved Int @default(0) consumed Int @default(0) period String startsAt DateTime? endsAt DateTime? status LifecycleStatus @default(ACTIVE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId], references:[id]) purchase Purchase @relation(fields:[purchaseId], references:[id]) packageEntitlement PackageEntitlement @relation(fields:[packageEntitlementId], references:[id]) usageRecords UsageRecord[] @@unique([purchaseId,packageEntitlementId]) @@index([userId,entitlementCode,status]) }
model UsageRecord { id String @id @default(cuid()) userId String entitlementGrantId String? entitlementCode String quantity Int status String idempotencyKey String @unique reservedAt DateTime @default(now()) confirmedAt DateTime? releasedAt DateTime? user User @relation(fields:[userId], references:[id]) entitlementGrant EntitlementGrant? @relation(fields:[entitlementGrantId], references:[id]) @@index([userId,entitlementCode,status]) @@index([entitlementGrantId,status]) }
model Invoice { id String @id @default(cuid()) purchaseId String number String @unique currency String totalMinor Int storageKey String? issuedAt DateTime @default(now()) purchase Purchase @relation(fields:[purchaseId], references:[id]) }
model Refund { id String @id @default(cuid()) paymentId String amountMinor Int reason String? providerRefundId String? createdAt DateTime @default(now()) payment Payment @relation(fields:[paymentId], references:[id]) }
model Coupon { id String @id @default(cuid()) code String @unique discount Discount? status LifecycleStatus @default(ACTIVE) }
model Discount { id String @id @default(cuid()) couponId String @unique type String value Int maxAmountMinor Int? coupon Coupon @relation(fields:[couponId], references:[id]) }
model AuditLog { id String @id @default(cuid()) actorUserId String? action String entityType String entityId String? metadata Json? createdAt DateTime @default(now()) @@index([entityType,entityId]) }
model AIUsage { id String @id @default(cuid()) userId String? jobId String? provider String model String capability String inputTokens Int? outputTokens Int? costMinor Int? currency String? createdAt DateTime @default(now()) }
model AIJob { id String @id @default(cuid()) userId String? projectId String? capability String provider String? providerJobId String? status JobStatus @default(QUEUED) input Json result Json? error Json? idempotencyKey String @unique retryCount Int @default(0) lastAttemptAt DateTime? completedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([status,capability]) }
model AnalyticsEvent { id String @id @default(cuid()) userId String? sessionId String? name String properties Json? occurredAt DateTime @default(now()) user User? @relation(fields:[userId], references:[id]) @@index([name,occurredAt]) }
