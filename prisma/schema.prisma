generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  DESIGNER
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobType {
  ROOM_UNDERSTANDING
  DESIGN_GENERATION
  DESIGN_REVISION
  THREE_D_SCENE
  PANORAMA
  WALKTHROUGH
  VIDEO
}

enum AssetType {
  FLOOR_PLAN
  ROOM_IMAGE
  DESIGN_IMAGE
  PANORAMA
  THREE_D_SCENE
  WALKTHROUGH
  VIDEO
  OTHER
}

enum PurchaseStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum EntitlementStatus {
  RESERVED
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum BoqStatus {
  DRAFT
  FINALIZED
}

enum ReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  DINING_ROOM
  BALCONY
  STUDY
  OTHER
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  OTHER
}

enum RoomUnderstandingSource {
  AI
  USER
  IMPORTED
}

enum RoomUnderstandingStatus {
  UNCONFIRMED
  CONFIRMED
  CORRECTED
  NEEDS_REVIEW
}

model User {
  id                         String                @id @default(cuid())
  email                      String                @unique
  name                       String?
  image                      String?
  role                       Role                  @default(USER)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  properties                 Property[]
  projects                   DesignProject[]
  purchases                  Purchase[]
  entitlements               Entitlement[]
  auditLogs                  AuditLog[]
  confirmedHomeIntelligences HomeIntelligence[]    @relation("HomeIntelligenceConfirmedBy")
  confirmedRoomUnderstandings RoomUnderstanding[] @relation("RoomUnderstandingConfirmedBy")
  createdHomeDnaVersions     HomeDnaVersion[]      @relation("HomeDnaCreatedBy")
  createdCatalogueSubstitutions CatalogueSubstitution[]
  procurementRequests        ProcurementRequest[]
  notifications              Notification[]
  ownReferralCode            ReferralCode?
  referralAsReferred         Referral?
  createdSupplierInvites     SupplierInvite[]
  onboardingRenderGrant      OnboardingRenderGrant?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id               String             @id @default(cuid())
  ownerId          String
  name             String
  address          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  owner            User               @relation(fields: [ownerId], references: [id])
  floorPlans       FloorPlan[]
  rooms            Room[]
  projects         DesignProject[]
  homeIntelligence HomeIntelligence?
  homeDnaVersions  HomeDnaVersion[]
  procurementRequests ProcurementRequest[]

  @@index([ownerId, createdAt])
}

model HomeIntelligence {
  id                 String       @id @default(cuid())
  propertyId         String       @unique
  version            Int          @default(1)
  propertyType       PropertyType
  configuration      String?
  possessionDate     DateTime?
  city               String?
  state              String?
  country            String       @default("India")
  carpetAreaSqFt     Decimal?     @db.Decimal(12, 2)
  metadata           Json?
  confirmedAt        DateTime?
  confirmedByUserId  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  property           Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  confirmedBy        User?        @relation("HomeIntelligenceConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([confirmedByUserId])
}

model HomeDnaVersion {
  id                      String   @id @default(cuid())
  propertyId              String
  version                 Int
  homeIntelligenceVersion Int
  household               Json
  lifestyle               Json
  designPersonality       Json
  storageNeeds            Json
  functionalNeeds         Json
  futureNeeds             Json
  smartHomePreferences    Json
  language                String   @default("en-IN")
  createdByUserId         String
  createdAt               DateTime @default(now())
  property                Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdBy               User     @relation("HomeDnaCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([propertyId, version])
  @@index([propertyId, createdAt])
  @@index([createdByUserId])
}

model FloorPlan {
  id         String   @id @default(cuid())
  propertyId String
  version    Int      @default(1)
  assetId    String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  asset      Asset    @relation(fields: [assetId], references: [id])

  @@unique([propertyId, version])
  @@index([propertyId])
}

model Room {
  id                String               @id @default(cuid())
  propertyId        String
  type              RoomType
  name              String
  areaSqFt          Decimal?             @db.Decimal(12, 2)
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  property          Property             @relation(fields: [propertyId], references: [id])
  projects          DesignProject[]
  roomUnderstandings RoomUnderstanding[]

  @@index([propertyId])
}

model RoomUnderstanding {
  id                String                  @id @default(cuid())
  roomId            String
  version           Int
  roomType          RoomType
  name              String
  confidenceBps     Int?
  source            RoomUnderstandingSource
  geometry          Json?
  dimensions        Json?
  constraints       Json?
  requirements      Json?
  status            RoomUnderstandingStatus @default(UNCONFIRMED)
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdAt         DateTime                @default(now())
  room              Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  confirmedBy       User?                   @relation("RoomUnderstandingConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@unique([roomId, version])
  @@index([roomId, createdAt])
  @@index([confirmedByUserId])
}

model DesignProject {
  id         String        @id @default(cuid())
  ownerId    String
  propertyId String
  roomId     String?
  name       String
  status     ProjectStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  owner      User          @relation(fields: [ownerId], references: [id])
  property   Property      @relation(fields: [propertyId], references: [id])
  room       Room?         @relation(fields: [roomId], references: [id])
  versions   DesignVersion[]
  revisions  DesignRevision[]
  jobs       AIJob[]
  boqs       Boq[]

  @@index([ownerId, createdAt])
  @@index([propertyId])
}

model DesignVersion {
  id         String        @id @default(cuid())
  projectId  String
  version    Int
  prompt     String?       @db.Text
  parameters Json?
  createdAt  DateTime      @default(now())
  project    DesignProject @relation(fields: [projectId], references: [id])
  assets     Asset[]

  @@unique([projectId, version])
  @@index([projectId])
}

model DesignRevision {
  id             String        @id @default(cuid())
  projectId      String
  baseVersionId  String
  revisionNumber Int
  instruction    String        @db.Text
  parameters     Json?
  createdAt      DateTime      @default(now())
  project        DesignProject @relation(fields: [projectId], references: [id])

  @@unique([projectId, revisionNumber])
  @@index([projectId, createdAt])
}

model Asset {
  id              String         @id @default(cuid())
  type            AssetType
  objectKey       String         @unique
  contentType     String
  sizeBytes       BigInt?
  checksum        String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  floorPlans      FloorPlan[]
  designVersionId String?
  designVersion   DesignVersion? @relation(fields: [designVersionId], references: [id])
  jobId           String?
  job             AIJob?         @relation(fields: [jobId], references: [id])

  @@index([type, createdAt])
  @@index([jobId])
}

model AIJob {
  id             String        @id @default(cuid())
  projectId      String
  type           JobType
  status         JobStatus     @default(QUEUED)
  idempotencyKey String
  provider       String?
  providerJobId  String?
  // Links this job to the exact CreditReservation it consumed, so the
  // worker's terminal-state transition can confirm (on success) or
  // release (on failure) the SAME reservation - never a different one,
  // never none at all. Without this link, credit consumption and job
  // outcome would be two independent systems with no way to keep them
  // honest with each other.
  creditReservationId String?
  input          Json?
  output         Json?
  errorCode      String?
  errorMessage   String?       @db.Text
  attempts       Int           @default(0)
  createdAt      DateTime      @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  project        DesignProject @relation(fields: [projectId], references: [id])
  assets         Asset[]

  @@unique([projectId, idempotencyKey])
  @@index([status, createdAt])
  @@index([provider, providerJobId])
}

model CatalogueItem {
  id          String           @id @default(cuid())
  sku         String           @unique
  name        String
  brand       String?
  description String?          @db.Text
  category    String
  unit        String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  prices      CataloguePrice[]
  boqLines    BoqLine[]
  substitutionsFrom CatalogueSubstitution[] @relation("SubstitutionFrom")
  substitutionsTo   CatalogueSubstitution[] @relation("SubstitutionTo")
}

model CataloguePrice {
  id            String        @id @default(cuid())
  itemId        String
  // MRP is the listed maximum retail price - what's printed on the
  // brand's own pricing, often higher than what's actually charged.
  // amountMinor remains the actual selling price used in real BOQ/budget
  // arithmetic; mrpMinor is optional (some sources genuinely have no
  // separate MRP concept) and is never used for financial calculations
  // itself - it exists to let the curation engine and customer-facing
  // display show "MRP vs actual price" transparently, matching real
  // Indian retail convention, without ever substituting one for the other.
  mrpMinor      BigInt?
  amountMinor   BigInt
  currency      String        @default("INR")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  item          CatalogueItem @relation(fields: [itemId], references: [id])

  @@index([itemId, effectiveFrom])
}

model Boq {
  id            String        @id @default(cuid())
  projectId     String
  version       Int           @default(1)
  status        BoqStatus     @default(DRAFT)
  currency      String        @default("INR")
  subtotalMinor BigInt        @default(0)
  taxMinor      BigInt        @default(0)
  discountMinor BigInt        @default(0)
  wastageMinor  BigInt        @default(0)
  totalMinor    BigInt        @default(0)
  snapshot      Json
  createdAt     DateTime      @default(now())
  project       DesignProject @relation(fields: [projectId], references: [id])
  lines         BoqLine[]

  @@unique([projectId, version])
}

model BoqLine {
  id              String         @id
  boqId           String
  catalogueItemId String?
  description     String
  quantity        Decimal        @db.Decimal(14, 4)
  unit            String
  unitPriceMinor  BigInt
  labourMinor     BigInt         @default(0)
  materialMinor   BigInt         @default(0)
  taxRateBps      Int            @default(0)
  wastageBps      Int            @default(0)
  discountMinor   BigInt         @default(0)
  lineTotalMinor  BigInt
  boq             Boq            @relation(fields: [boqId], references: [id], onDelete: Cascade)
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id])

  @@index([boqId])
}

model Package {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  priceMinor   BigInt
  currency     String        @default("INR")
  credits      Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  purchases    Purchase[]
  entitlements Entitlement[]
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  packageId       String
  status          PurchaseStatus @default(CREATED)
  amountMinor     BigInt
  currency        String         @default("INR")
  provider        String?
  providerOrderId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
  package         Package        @relation(fields: [packageId], references: [id])
  payment         Payment?
  entitlements    Entitlement[]

  @@index([userId, createdAt])
}

model Payment {
  id                String        @id
  purchaseId        String        @unique
  status            PaymentStatus @default(CREATED)
  providerPaymentId String?       @unique
  amountMinor       BigInt
  currency          String
  signature         String?
  rawEventHash      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  purchase          Purchase      @relation(fields: [purchaseId], references: [id])

  @@index([status, createdAt])
}

model Entitlement {
  id                 String            @id @default(cuid())
  userId             String
  purchaseId         String?
  packageId          String
  status             EntitlementStatus @default(ACTIVE)
  creditsTotal       Int
  creditsReserved    Int               @default(0)
  creditsConsumed    Int               @default(0)
  idempotencyKey     String
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id])
  purchase           Purchase?         @relation(fields: [purchaseId], references: [id])
  package            Package           @relation(fields: [packageId], references: [id])
  creditReservations CreditReservation[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
}

model CreditReservation {
  id             String            @id @default(cuid())
  entitlementId  String
  credits        Int
  idempotencyKey String            @unique
  status         ReservationStatus @default(RESERVED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  entitlement    Entitlement       @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([entitlementId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}

// Phase 1 Step 2 market-intelligence persistence parity.
// Foreign-key columns intentionally remain scalar here; the existing additive
// migrations own database constraints while services own authorization and
// cross-entity invariants.
model MarketSource {
  id                   String   @id
  canonicalName        String   @unique
  domain               String?
  sourceType           String
  geographies          Json?
  categories           Json
  acquisitionMethod    String
  accessStatus         String
  termsReference       String?
  licensingStatus      String?
  ingestionEligible    Boolean  @default(false)
  freshnessPolicyHours Int?
  provenancePolicy     String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime

  @@index([sourceType, active])
  @@index([ingestionEligible, active])
}

model MarketVendor {
  id              String   @id
  sourceId        String
  canonicalName   String
  brandName       String?
  sellerType      String
  sellerReference String?
  geography       Json?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@unique([sourceId, canonicalName])
  @@index([canonicalName])
}

model MarketProduct {
  id            String   @id
  canonicalKey  String   @unique
  brand         String?
  title         String
  description   String?
  category      String
  subcategory   String?
  dimensions    Json?
  material      String?
  finish        String?
  configuration Json?
  customization Json?
  media         Json?
  attributes    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([category, subcategory])
  @@index([brand])
}

model MarketSourceProduct {
  id               String   @id
  sourceId         String
  vendorId         String?
  productId        String
  sourceProductId  String
  sku              String?
  url              String?
  titleObserved    String?
  variant          Json?
  sourceAttributes Json?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  active           Boolean  @default(true)

  @@unique([sourceId, sourceProductId])
  @@index([productId])
  @@index([vendorId])
}

model MarketPriceObservation {
  id                    String   @id
  sourceProductId       String
  observedAt            DateTime
  amountMinor           BigInt
  listAmountMinor       BigInt?
  currency              String   @default("INR")
  unit                  String
  taxIncluded           Boolean?
  shippingIncluded      Boolean?
  installationIncluded  Boolean?
  location              Json?
  availability          String?
  evidence              Json
  retrievalMethod       String
  confidenceBps         Int?
  freshUntil            DateTime?
  createdAt             DateTime @default(now())

  @@index([sourceProductId, observedAt])
  @@index([observedAt])
  @@index([amountMinor])
  @@index([freshUntil])
}

model MarketProductRelationship {
  id               String   @id
  fromProductId    String
  toProductId      String
  relationshipType String
  confidenceBps    Int?
  evidence         Json?
  createdAt        DateTime @default(now())

  @@unique([fromProductId, toProductId, relationshipType])
  @@index([fromProductId, relationshipType])
}

model MarketIngestionRun {
  id              String   @id
  sourceId        String
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String
  idempotencyKey  String
  recordsSeen     Int      @default(0)
  recordsAccepted Int      @default(0)
  recordsRejected Int      @default(0)
  errorSummary    Json?

  @@unique([sourceId, idempotencyKey])
  @@index([sourceId, startedAt])
}

model MarketEvidence {
  id              String   @id
  sourceId        String
  sourceProductId String?
  retrievedAt     DateTime
  retrievalMethod String
  locator         String?
  contentHash     String?
  excerpt         String?
  metadata        Json?

  @@index([sourceId, retrievedAt])
  @@index([sourceProductId])
}

enum SubstitutionImpact {
  IMPROVED
  SAME
  REDUCED
  UNKNOWN
}

// Curated, evidence-backed alternative relationship (README §8 ALTERNATIVE_TO).
// Complementary to marketIntelligence/substitution.ts's pure ranking logic:
// that module ranks candidate offers by computed score, this model records
// a human (admin/designer) explicitly stating a trade-off, since quality/
// maintenance/durability impact cannot be honestly auto-derived without a
// material-attribute schema this system doesn't have.
model CatalogueSubstitution {
  id                  String             @id @default(cuid())
  fromCatalogueItemId String
  toCatalogueItemId   String
  qualityImpact       SubstitutionImpact @default(UNKNOWN)
  maintenanceImpact   SubstitutionImpact @default(UNKNOWN)
  appearanceImpact    SubstitutionImpact @default(UNKNOWN)
  durabilityImpact    SubstitutionImpact @default(UNKNOWN)
  explanation         String             @db.Text
  createdByUserId     String
  createdAt           DateTime           @default(now())
  fromCatalogueItem   CatalogueItem      @relation("SubstitutionFrom", fields: [fromCatalogueItemId], references: [id])
  toCatalogueItem     CatalogueItem      @relation("SubstitutionTo", fields: [toCatalogueItemId], references: [id])
  createdBy           User               @relation(fields: [createdByUserId], references: [id])

  @@unique([fromCatalogueItemId, toCatalogueItemId])
  @@index([fromCatalogueItemId])
}

enum ProcurementRequestStatus {
  DRAFT
  RFQ_SENT
  QUOTES_RECEIVED
  ORDERED
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ExecutionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SNAGGED
  RESOLVED
}

// README §26: RFQ -> Quote Comparison -> Order -> Delivery. Only begins
// from a locked BudgetPlan (the real budget system, in BudgetPlan/
// BudgetVersion - queried via raw SQL by procurementRepository since those
// tables have no typed Prisma model here). lockedBudgetPlanId/
// lockedBudgetVersion are plain scalar references rather than a Prisma
// relation for that reason - the FK integrity for that side is enforced
// by the service layer's lock check, not the database schema.
model ProcurementRequest {
  id                  String                   @id @default(cuid())
  propertyId          String
  ownerId             String
  lockedBudgetPlanId  String
  lockedBudgetVersion Int
  status              ProcurementRequestStatus @default(DRAFT)
  idempotencyKey      String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  property            Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner               User                     @relation(fields: [ownerId], references: [id])
  quotes              Quote[]
  orders              Order[]
  supplierInvites     SupplierInvite[]

  @@unique([propertyId, idempotencyKey])
}

model Quote {
  id                   String             @id @default(cuid())
  procurementRequestId String
  supplierName         String
  totalAmountMinor     BigInt
  currency             String             @default("INR")
  status               QuoteStatus        @default(SUBMITTED)
  validUntil           DateTime?
  notes                String?            @db.Text
  // Nivasa's commission and minimum-acceptable-margin are fixed at
  // submission time, not recomputed later - this is the actual mechanism
  // that keeps negotiation profitable: minMarginBps defines the floor
  // percentage of totalAmountMinor that must remain as Nivasa's margin no
  // matter how a negotiation ends, so a user can never negotiate away more
  // than the business decided it could afford to give up when the quote
  // was first accepted into the system.
  nivasaCommissionBps  Int                @default(1000)
  minMarginBps         Int                @default(500)
  createdAt            DateTime           @default(now())
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  order                Order?
  negotiations         QuoteNegotiation[]

  @@index([procurementRequestId, status])
}

model Order {
  id                   String             @id @default(cuid())
  procurementRequestId String
  quoteId              String             @unique
  status               OrderStatus        @default(PLACED)
  totalAmountMinor     BigInt
  currency             String             @default("INR")
  placedAt             DateTime           @default(now())
  deliveredAt          DateTime?
  procurementRequest   ProcurementRequest @relation(fields: [procurementRequestId], references: [id])
  quote                Quote              @relation(fields: [quoteId], references: [id])
  executions           ExecutionRecord[]

  @@index([procurementRequestId])
}

model ExecutionRecord {
  id            String          @id @default(cuid())
  orderId       String
  status        ExecutionStatus @default(SCHEDULED)
  scheduledDate DateTime?
  completedAt   DateTime?
  snagNotes     String?         @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

enum NotificationType {
  ORDER_STATUS_CHANGED
  QUOTE_RECEIVED
  EXECUTION_STATUS_CHANGED
  BUDGET_LOCKED
  GENERAL
  // README §30 Niwasthan Moments - real, useful project events given
  // personality-infused framing (see momentTemplates.ts), never replacing
  // the underlying factual notification, only adding brand voice to it.
  PRICE_DROP
  BETTER_ALTERNATIVE_FOUND
  BUDGET_EXCEEDED
  DESIGN_APPROVED
  WALKTHROUGH_READY
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  type              NotificationType
  title             String
  message           String           @db.Text
  relatedEntityType String?
  relatedEntityId   String?
  read              Boolean          @default(false)
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

enum NegotiationDecision {
  ACCEPTED
  COUNTERED
  REJECTED
}

// The floor logic that keeps negotiation profitable for Nivasa is defined
// entirely on the Quote itself, set at quote-submission time - not derived
// ad hoc at negotiation time - so the floor a user negotiates against can
// never be changed retroactively to move the goalposts mid-negotiation.
model QuoteNegotiation {
  id                  String              @id @default(cuid())
  quoteId             String
  proposedAmountMinor BigInt
  decision            NegotiationDecision
  counterAmountMinor  BigInt?
  createdAt           DateTime            @default(now())
  quote               Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

enum ReferralStatus {
  PENDING
  REWARDED
  EXPIRED
}

// Every user gets exactly one stable referral code (their own invite
// link). A referral only pays out once the referred user completes a
// real, revenue-generating action (an Order actually delivered) - not on
// sign-up alone, which would be trivially gameable by creating throwaway
// accounts.
model ReferralCode {
  id          String     @id @default(cuid())
  ownerUserId String     @unique
  code        String     @unique
  createdAt   DateTime   @default(now())
  owner       User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  referrals   Referral[]
}

model Referral {
  id               String         @id @default(cuid())
  referralCodeId   String
  referredUserId   String         @unique
  status           ReferralStatus @default(PENDING)
  triggeringOrderId String?
  bonusCredits     Int?
  rewardedAt       DateTime?
  createdAt        DateTime       @default(now())
  referralCode     ReferralCode   @relation(fields: [referralCodeId], references: [id])
  referredUser     User           @relation(fields: [referredUserId], references: [id])

  @@index([referralCodeId, status])
}

// Suppliers are external parties who never need a full platform account -
// building a parallel user/auth system for occasional quote submission
// would be significant unnecessary scope. Instead, access is a signed,
// single-use, time-limited token: the raw token is emailed/shared once
// and never stored - only its SHA-256 hash is persisted, so a database
// read can never leak a usable credential (the same principle as never
// storing a plaintext password).
model SupplierInvite {
  id                    String              @id @default(cuid())
  procurementRequestId  String
  supplierName          String
  tokenHash             String              @unique
  expiresAt             DateTime
  usedAt                DateTime?
  quoteId               String?
  createdByUserId       String
  createdAt             DateTime            @default(now())
  procurementRequest    ProcurementRequest  @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  createdBy             User                @relation(fields: [createdByUserId], references: [id])

  @@index([procurementRequestId])
}

// The trust-building mechanism: every user gets exactly one HD-quality
// visualization for free, regardless of their plan - a bounded,
// per-user, one-time cost (not per-transaction margin erosion) meant to
// let a prospective customer see genuinely great output before they've
// paid anything, which is the actual conversion lever, not a recurring
// discount. Tracked as its own row (not a boolean flag on User) so the
// grant is auditable: which asset it produced, when it was used.
model OnboardingRenderGrant {
  id         String    @id @default(cuid())
  userId     String    @unique
  usedAt     DateTime?
  assetId    String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
