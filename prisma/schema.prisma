generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  DESIGNER
  ADMIN
  SUPER_ADMIN
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobType {
  ROOM_UNDERSTANDING
  DESIGN_GENERATION
  DESIGN_REVISION
  THREE_D_SCENE
  PANORAMA
  WALKTHROUGH
  VIDEO
}

enum AssetType {
  FLOOR_PLAN
  ROOM_IMAGE
  DESIGN_IMAGE
  PANORAMA
  THREE_D_SCENE
  WALKTHROUGH
  VIDEO
  OTHER
}

enum PurchaseStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum EntitlementStatus {
  RESERVED
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum BoqStatus {
  DRAFT
  FINALIZED
}

enum ReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum RoomType {
  LIVING_ROOM
  BEDROOM
  KITCHEN
  BATHROOM
  DINING_ROOM
  BALCONY
  STUDY
  OTHER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  image        String?
  role         Role            @default(USER)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  accounts     Account[]
  sessions     Session[]
  properties   Property[]
  projects     DesignProject[]
  purchases    Purchase[]
  entitlements Entitlement[]
  auditLogs    AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id         String          @id @default(cuid())
  ownerId    String
  name       String
  address    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  owner      User            @relation(fields: [ownerId], references: [id])
  floorPlans FloorPlan[]
  rooms      Room[]
  projects   DesignProject[]

  @@index([ownerId, createdAt])
}

model FloorPlan {
  id         String   @id @default(cuid())
  propertyId String
  version    Int      @default(1)
  assetId    String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id])
  asset      Asset    @relation(fields: [assetId], references: [id])

  @@unique([propertyId, version])
  @@index([propertyId])
}

model Room {
  id         String          @id @default(cuid())
  propertyId String
  type       RoomType
  name       String
  areaSqFt   Decimal?        @db.Decimal(12, 2)
  metadata   Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  property   Property        @relation(fields: [propertyId], references: [id])
  projects   DesignProject[]

  @@index([propertyId])
}

model DesignProject {
  id         String          @id @default(cuid())
  ownerId    String
  propertyId String
  roomId     String?
  name       String
  status     ProjectStatus   @default(DRAFT)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  owner      User            @relation(fields: [ownerId], references: [id])
  property   Property        @relation(fields: [propertyId], references: [id])
  room       Room?           @relation(fields: [roomId], references: [id])
  versions   DesignVersion[]
  jobs       AIJob[]
  boqs       Boq[]

  @@index([ownerId, createdAt])
  @@index([propertyId])
}

model DesignVersion {
  id         String        @id @default(cuid())
  projectId  String
  version    Int
  prompt     String?       @db.Text
  parameters Json?
  createdAt  DateTime      @default(now())
  project    DesignProject @relation(fields: [projectId], references: [id])
  assets     Asset[]

  @@unique([projectId, version])
  @@index([projectId])
}

model Asset {
  id              String         @id @default(cuid())
  type            AssetType
  objectKey       String         @unique
  contentType     String
  sizeBytes       BigInt?
  checksum        String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  floorPlans      FloorPlan[]
  designVersionId String?
  designVersion   DesignVersion? @relation(fields: [designVersionId], references: [id])
  jobId           String?
  job             AIJob?         @relation(fields: [jobId], references: [id])

  @@index([type, createdAt])
  @@index([jobId])
}

model AIJob {
  id             String        @id @default(cuid())
  projectId      String
  type           JobType
  status         JobStatus     @default(QUEUED)
  idempotencyKey String
  provider       String?
  providerJobId  String?
  input          Json?
  output         Json?
  errorCode      String?
  errorMessage   String?       @db.Text
  attempts       Int           @default(0)
  createdAt      DateTime      @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  project        DesignProject @relation(fields: [projectId], references: [id])
  assets         Asset[]

  @@unique([projectId, idempotencyKey])
  @@index([status, createdAt])
  @@index([provider, providerJobId])
}

model CatalogueItem {
  id          String           @id @default(cuid())
  sku         String           @unique
  name        String
  description String?          @db.Text
  category    String
  unit        String
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  prices      CataloguePrice[]
  boqLines    BoqLine[]
}

model CataloguePrice {
  id            String        @id @default(cuid())
  itemId        String
  amountMinor   BigInt
  currency      String        @default("INR")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  item          CatalogueItem @relation(fields: [itemId], references: [id])

  @@index([itemId, effectiveFrom])
}

model Boq {
  id            String        @id @default(cuid())
  projectId     String
  version       Int           @default(1)
  status        BoqStatus     @default(DRAFT)
  currency      String        @default("INR")
  subtotalMinor BigInt        @default(0)
  taxMinor      BigInt        @default(0)
  discountMinor BigInt        @default(0)
  wastageMinor  BigInt        @default(0)
  totalMinor    BigInt        @default(0)
  snapshot      Json
  createdAt     DateTime      @default(now())
  project       DesignProject @relation(fields: [projectId], references: [id])
  lines         BoqLine[]

  @@unique([projectId, version])
}

model BoqLine {
  id              String         @id @default(cuid())
  boqId           String
  catalogueItemId String?
  description     String
  quantity        Decimal        @db.Decimal(14, 4)
  unit            String
  unitPriceMinor  BigInt
  labourMinor     BigInt         @default(0)
  materialMinor   BigInt         @default(0)
  taxRateBps      Int            @default(0)
  wastageBps      Int            @default(0)
  discountMinor   BigInt         @default(0)
  lineTotalMinor  BigInt
  boq             Boq            @relation(fields: [boqId], references: [id], onDelete: Cascade)
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id])

  @@index([boqId])
}

model Package {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  priceMinor   BigInt
  currency     String        @default("INR")
  credits      Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  purchases    Purchase[]
  entitlements Entitlement[]
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  packageId       String
  status          PurchaseStatus @default(CREATED)
  amountMinor     BigInt
  currency        String         @default("INR")
  provider        String?
  providerOrderId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
  package         Package        @relation(fields: [packageId], references: [id])
  payment         Payment?
  entitlements    Entitlement[]

  @@index([userId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  purchaseId        String        @unique
  status            PaymentStatus @default(CREATED)
  providerPaymentId String?       @unique
  amountMinor       BigInt
  currency          String
  signature         String?
  rawEventHash      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  purchase          Purchase      @relation(fields: [purchaseId], references: [id])

  @@index([status, createdAt])
}

model Entitlement {
  id                 String              @id @default(cuid())
  userId             String
  purchaseId         String?
  packageId          String
  status             EntitlementStatus   @default(ACTIVE)
  creditsTotal       Int
  creditsReserved    Int                 @default(0)
  creditsConsumed    Int                 @default(0)
  idempotencyKey     String
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  purchase           Purchase?           @relation(fields: [purchaseId], references: [id])
  package            Package             @relation(fields: [packageId], references: [id])
  creditReservations CreditReservation[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
}

/// A reservation records one idempotent credit hold. State transitions must use
/// conditional updates so only a RESERVED reservation can be confirmed or released.
model CreditReservation {
  id             String            @id @default(cuid())
  entitlementId  String
  credits        Int
  idempotencyKey String            @unique
  status         ReservationStatus @default(RESERVED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  entitlement    Entitlement       @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([entitlementId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
}
